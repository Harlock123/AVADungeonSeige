<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Dungeon Siege (2002) palette: weathered stone, oiled leather, tarnished gold,
    and saturated ruby / sapphire for the vitals.
  -->

  <!-- Typography: Cinzel/Trajan if installed, otherwise the best old-style serif available. -->
  <FontFamily x:Key="SerifFont">Cinzel, Trajan Pro, Palatino Linotype, Book Antiqua, Palatino, Georgia, Noto Serif, Liberation Serif, serif</FontFamily>
  <FontFamily x:Key="BodyFont">Palatino Linotype, Book Antiqua, Palatino, Georgia, Noto Serif, Liberation Serif, serif</FontFamily>

  <!-- Stone -->
  <Color x:Key="StoneBlackColor">#0E0C0A</Color>
  <Color x:Key="StoneDarkColor">#1A1714</Color>
  <Color x:Key="StoneColor">#2B2723</Color>
  <Color x:Key="StoneMidColor">#3E3831</Color>
  <Color x:Key="StoneLightColor">#5C5348</Color>
  <Color x:Key="StoneHighlightColor">#837664</Color>

  <!-- Earth / leather -->
  <Color x:Key="EarthColor">#3A2918</Color>
  <Color x:Key="LeatherColor">#5B3A21</Color>

  <!-- Gold -->
  <Color x:Key="GoldDarkColor">#5E4A20</Color>
  <Color x:Key="GoldColor">#B8913F</Color>
  <Color x:Key="GoldBrightColor">#F0D27A</Color>

  <!-- Text -->
  <Color x:Key="ParchmentColor">#E3D5B0</Color>
  <Color x:Key="ParchmentDimColor">#A8987A</Color>

  <!-- Vitals -->
  <Color x:Key="RubyColor">#C0141E</Color>
  <Color x:Key="RubyDarkColor">#4A0508</Color>
  <Color x:Key="SapphireColor">#2050D0</Color>
  <Color x:Key="SapphireDarkColor">#0A1A48</Color>
  <Color x:Key="EmeraldColor">#4FAF4A</Color>

  <SolidColorBrush x:Key="StoneBlackBrush" Color="{StaticResource StoneBlackColor}" />
  <SolidColorBrush x:Key="StoneDarkBrush" Color="{StaticResource StoneDarkColor}" />
  <SolidColorBrush x:Key="StoneBrush" Color="{StaticResource StoneColor}" />
  <SolidColorBrush x:Key="StoneMidBrush" Color="{StaticResource StoneMidColor}" />
  <SolidColorBrush x:Key="StoneLightBrush" Color="{StaticResource StoneLightColor}" />
  <SolidColorBrush x:Key="StoneHighlightBrush" Color="{StaticResource StoneHighlightColor}" />
  <SolidColorBrush x:Key="LeatherBrush" Color="{StaticResource LeatherColor}" />
  <SolidColorBrush x:Key="GoldDarkBrush" Color="{StaticResource GoldDarkColor}" />
  <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
  <SolidColorBrush x:Key="GoldBrightBrush" Color="{StaticResource GoldBrightColor}" />
  <SolidColorBrush x:Key="ParchmentBrush" Color="{StaticResource ParchmentColor}" />
  <SolidColorBrush x:Key="ParchmentDimBrush" Color="{StaticResource ParchmentDimColor}" />
  <SolidColorBrush x:Key="EmeraldBrush" Color="{StaticResource EmeraldColor}" />

  <!-- Vital bars: glossy jewel gradients -->
  <LinearGradientBrush x:Key="HealthBrush" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Offset="0" Color="#7A0A10" />
    <GradientStop Offset="0.45" Color="#E0303A" />
    <GradientStop Offset="1" Color="#8A0C14" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ManaBrush" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Offset="0" Color="#0C2A80" />
    <GradientStop Offset="0.45" Color="#4A7CF0" />
    <GradientStop Offset="1" Color="#0E2E90" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="HealthBarBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#E0303A" />
    <GradientStop Offset="1" Color="#7A0A10" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="ManaBarBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#4A7CF0" />
    <GradientStop Offset="1" Color="#0C2A80" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="XpBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#F0D27A" />
    <GradientStop Offset="1" Color="#8A6A28" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="BarTroughBrush" Color="#120A08" />
  <LinearGradientBrush x:Key="BarGlossBrush" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Offset="0" Color="#00FFFFFF" />
    <GradientStop Offset="0.35" Color="#38FFFFFF" />
    <GradientStop Offset="0.55" Color="#00FFFFFF" />
  </LinearGradientBrush>

  <!-- Chiselled stone surfaces -->
  <LinearGradientBrush x:Key="StoneButtonBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#5A5146" />
    <GradientStop Offset="0.5" Color="#3B352E" />
    <GradientStop Offset="1" Color="#26221E" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="StoneButtonHoverBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#6E6354" />
    <GradientStop Offset="0.5" Color="#4A4238" />
    <GradientStop Offset="1" Color="#2E2924" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="StoneButtonPressedBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#1E1B18" />
    <GradientStop Offset="1" Color="#3B352E" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GoldActiveBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#7A6230" />
    <GradientStop Offset="0.5" Color="#4E3E1C" />
    <GradientStop Offset="1" Color="#2E2410" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GoldTrimBrush" StartPoint="0%,0%" EndPoint="100%,0%">
    <GradientStop Offset="0" Color="#5E4A20" />
    <GradientStop Offset="0.5" Color="#F0D27A" />
    <GradientStop Offset="1" Color="#5E4A20" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="InsetBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#0C0A08" />
    <GradientStop Offset="1" Color="#1C1915" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="WindowHeaderBrush" StartPoint="0%,0%" EndPoint="0%,100%">
    <GradientStop Offset="0" Color="#4E3E1C" />
    <GradientStop Offset="1" Color="#2A2010" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="WindowBodyBrush" Color="#EE16120E" />
  <SolidColorBrush x:Key="OverlayPlateBrush" Color="#C0100D0A" />
</ResourceDictionary>
