<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DungeonSiege.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="/Themes/Palette.axaml" />
        <ResourceInclude Source="/Themes/Icons.axaml" />
        <ResourceInclude Source="/Themes/ControlThemes.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <!-- Fluent supplies sane defaults for scrollbars, tooltips etc.; our themes override the rest. -->
    <FluentTheme />
    <StyleInclude Source="/Themes/HudStyles.axaml" />
  </Application.Styles>
</Application>
